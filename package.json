{
  "name": "aditzak-deseraiki", "version": "0.1.0", "private": true,
  "type": "module", "license": "GPL-3.0-only",
  "engines": { "node": ">=24" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev -w @aditzak/api' 'npm run dev -w @aditzak/web'",
    "data:fetch": "tsx scripts/fetch-sources.ts",
    "data:build": "tsx scripts/build-data.ts",
    "audit:alokutibo": "tsx scripts/audit-alokutibo.ts",
    "audit:laguntzaile": "tsx scripts/audit-laguntzaile.ts",
    "audit:laguntzaile:semantika": "tsx scripts/audit-laguntzaile-semantika.ts",
    "build": "npm run build -w @aditzak/api && npm run build -w @aditzak/web",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0", "@types/node": "^24.0.0", "concurrently": "^9.2.0",
    "tsx": "^4.20.0", "typescript": "^5.9.0", "vue-tsc": "^3.1.0"
  }
}
