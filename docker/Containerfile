FROM docker.io/library/node:24-alpine AS base
WORKDIR /build
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN --mount=type=secret,id=build_ca,target=/etc/ssl/certs/ca-certificates.crt,required=false NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt npm ci
COPY . .

# With both build arguments set, consume an immutable GitHub Release asset.
# With both empty, retain the reproducible local source-build path.
FROM base AS database
ARG DATABASE_RELEASE_URL=""
ARG DATABASE_RELEASE_SHA256=""
RUN --mount=type=secret,id=build_ca,target=/etc/ssl/certs/ca-certificates.crt,required=false \
    apk add --no-cache curl sqlite zstd && \
    npm run data:fetch && \
    if [ -n "$DATABASE_RELEASE_URL" ] && [ -n "$DATABASE_RELEASE_SHA256" ]; then \
      mkdir -p data/generated && \
      curl --fail --show-error --location --retry 4 --connect-timeout 20 \
        "$DATABASE_RELEASE_URL" -o /tmp/aditzak.sqlite.zst && \
      echo "$DATABASE_RELEASE_SHA256  /tmp/aditzak.sqlite.zst" | sha256sum -c - && \
      zstd --decompress --no-progress /tmp/aditzak.sqlite.zst -o data/generated/aditzak.sqlite; \
    elif [ -z "$DATABASE_RELEASE_URL" ] && [ -z "$DATABASE_RELEASE_SHA256" ]; then \
      npm run data:build; \
    else \
      echo 'DATABASE_RELEASE_URL eta DATABASE_RELEASE_SHA256 biak batera eman behar dira' >&2; \
      exit 1; \
    fi && \
    sqlite3 data/generated/aditzak.sqlite 'PRAGMA integrity_check;' | grep -qx ok && \
    sqlite3 data/generated/aditzak.sqlite "SELECT json_extract(value, '$.complete') FROM metadata WHERE key='coverage';" | grep -qx 1

FROM base AS web-build
RUN npm run build -w @aditzak/web

FROM docker.io/denoland/deno:2.9.0 AS api
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 DATABASE_PATH=/app/data/aditzak.sqlite DENO_DIR=/tmp/deno
WORKDIR /app
COPY --from=base /build/package.json ./package.json
COPY --from=base /build/node_modules ./node_modules
COPY --from=base /build/apps/api/package.json ./apps/api/package.json
COPY --from=base /build/apps/api/src ./apps/api/src
COPY --from=base /build/packages/shared/package.json ./packages/shared/package.json
COPY --from=base /build/packages/shared/src ./packages/shared/src
COPY --from=database /build/data/generated/aditzak.sqlite ./data/aditzak.sqlite
# Corpus, license and full corresponding project source accompany the binary DB.
COPY --from=database /build/data/vendor/apertium-eus /usr/share/aditzak-source/data/vendor/apertium-eus
COPY --from=base /build/scripts /usr/share/aditzak-source/scripts
COPY --from=base /build/data/sources.json /usr/share/aditzak-source/data/sources.json
COPY --from=base /build/apps /usr/share/aditzak-source/apps
COPY --from=base /build/packages /usr/share/aditzak-source/packages
COPY --from=base /build/package.json /build/package-lock.json /build/tsconfig.json /build/LICENSE /build/NOTICE.md /usr/share/aditzak-source/
USER deno
EXPOSE 3000
CMD ["deno","run","--cached-only","--node-modules-dir=manual","--allow-read=/app","--allow-env","--allow-net","--allow-sys=networkInterfaces","apps/api/src/server.ts"]

FROM docker.io/library/caddy:2.11.4-alpine AS web
ENV XDG_DATA_HOME=/tmp/caddy-data XDG_CONFIG_HOME=/tmp/caddy-config
# Port 8080 needs no privileged bind capability; retaining the image's
# file capability conflicts with cap_drop: ALL in rootless Podman.
RUN setcap -r /usr/bin/caddy
COPY docker/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /build/apps/web/dist /usr/share/caddy
USER 10001:10001
EXPOSE 8080
CMD ["caddy","run","--config","/etc/caddy/Caddyfile","--adapter","caddyfile"]
