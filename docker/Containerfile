FROM docker.io/library/node:24-alpine AS build
WORKDIR /build
RUN --mount=type=secret,id=build_ca,target=/etc/ssl/certs/ca-certificates.crt,required=false apk add --no-cache curl
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN --mount=type=secret,id=build_ca,target=/etc/ssl/certs/ca-certificates.crt,required=false NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt npm ci
COPY . .
RUN --mount=type=secret,id=build_ca,target=/etc/ssl/certs/ca-certificates.crt,required=false npm run data:fetch && npm run data:build && npm run build

FROM docker.io/library/node:24-alpine AS api
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 DATABASE_PATH=/app/data/aditzak.sqlite
WORKDIR /app
COPY --from=build /build/package.json ./package.json
COPY --from=build /build/node_modules ./node_modules
COPY --from=build /build/apps/api/dist ./dist
COPY --from=build /build/data/generated/aditzak.sqlite ./data/aditzak.sqlite
# Corpus, license and full corresponding project source accompany the binary DB.
COPY --from=build /build/data/vendor/apertium-eus /usr/share/aditzak-source/data/vendor/apertium-eus
COPY --from=build /build/scripts /usr/share/aditzak-source/scripts
COPY --from=build /build/data/sources.json /usr/share/aditzak-source/data/sources.json
COPY --from=build /build/apps /usr/share/aditzak-source/apps
COPY --from=build /build/packages /usr/share/aditzak-source/packages
COPY --from=build /build/package.json /build/package-lock.json /build/tsconfig.json /build/LICENSE /build/NOTICE.md /usr/share/aditzak-source/
USER node
EXPOSE 3000
CMD ["node","dist/apps/api/src/server.js"]

FROM docker.io/library/nginx:stable-alpine AS web
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /build/apps/web/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g","daemon off;"]
